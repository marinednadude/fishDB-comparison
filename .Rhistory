identifier_input_file <- here("gap_analysis_code","00_scripts","fishcard_attempt","NCBI_search/taxIDs/taxids_identifier_onePerLine.txt")
accepted_input_file <- here("gap_analysis_code","00_scripts","fishcard_attempt","NCBI_search/taxIDs/taxids_accepted_onePerLine.txt")
identifier_output_file <- here("gap_analysis_code","00_scripts","fishcard_attempt","NCBI_search/taxIDs/subtree_identifier_taxids.txt")
accepted_output_file <- here("gap_analysis_code","00_scripts","fishcard_attempt","NCBI_search/taxIDs/subtree_accepted_taxids.txt")
