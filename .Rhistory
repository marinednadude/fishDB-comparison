identifier_list <- UPDATED_FULL_RECORD_DB %>%
filter(!is.na(identifier)) %>%
select(identifier) %>%
distinct() %>%
mutate(identifier = str_remove(identifier, "NCBI:txid")) %>%
pull(identifier)
accepted_list <- UPDATED_FULL_RECORD_DB %>%
filter(!is.na(accepted_NCBI)) %>%
select(accepted_NCBI) %>%
